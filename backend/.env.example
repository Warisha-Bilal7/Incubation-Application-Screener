# Copy to .env (never commit .env)

# ---- AI ----
# auto = Gemini if GEMINI_API_KEY is set, otherwise mock. Force with "mock" or "gemini".
AI_MODE=auto
GEMINI_API_KEY=
# "gemini-flash-latest" tracks the newest Flash model. Run `python ../scripts/check_gemini.py`
# to list the models your key can use, then pin one here.
GEMINI_MODEL=gemini-flash-latest

# ---- Storage ----
# file = JSON file in DATA_DIR (zero setup). supabase = Postgres via Supabase REST (needed on Render, whose disk is wiped on redeploy).
STORE_BACKEND=file
DATA_DIR=./data/runtime
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ---- Reviewer auth ----
# none = open (local dev only). key = header X-Reviewer-Key must equal REVIEWER_KEY.
# supabase = Authorization: Bearer <Supabase user JWT>, and the user's email must be in REVIEWER_EMAILS.
AUTH_MODE=none
REVIEWER_KEY=change-me
REVIEWER_EMAILS=

# ---- Misc ----
CORS_ORIGINS=*
MAX_DECK_MB=10
RATE_LIMIT_PER_HOUR=30
ENABLE_DEV_ROUTES=true
# Assumptions shown on the dashboard. Replace with real numbers you can defend.
ASSUMED_MANUAL_MINUTES=15
ASSUMED_CARD_MINUTES=3

# Folder served at / (the backend serves the frontend, so the whole app is one URL). Default: ../frontend
FRONTEND_DIR=../frontend
